{
    "spec": 1,
    "name": "Roboto",
    "previewText": "Roboto is Google’s signature sans serif UI typeface — clean, neutral and very very pixel-friendy lol .",
    "main": {
        // boldest / black
        "ABCGintoNord-ExtraBold": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Black.ttf",
        "ggsans-ExtraBold": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Black.ttf",
        "ggsans-ExtraBoldItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-BlackItalic.ttf",

        // bold
        "ggsans-Bold": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Bold.ttf",
        "ggsans-BoldItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-BoldItalic.ttf",

        // semi
        "ggsans-Semibold": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Medium.ttf",
        "ggsans-SemiboldItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-MediumItalic.ttf",

        // medium
        "ggsans-Medium": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Medium.ttf",
        "ggsans-MediumItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-MediumItalic.ttf",

        // normal / regular
        "ggsans-Normal": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Regular.ttf",
        "ggsans-NormalItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Italic.ttf",

        // lighter versions (not in your original spec, but lol why not)
        "ggsans-Light": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Light.ttf",
        "ggsans-LightItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-LightItalic.ttf",

        // optional (thin & thin italic)
        "ggsans-Thin": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Thin.ttf",
        "ggsans-ThinItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-ThinItalic.ttf",

        // fallback/core
        "NotoSans-Normal": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Regular.ttf",
        "NotoSans-NormalItalic": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Italic.ttf",

        // monospace variant (if you want code style lol)
        "SourceCodePro-Semibold": "https://github.com/google/fonts/raw/main/apache/roboto/Roboto-Medium.ttf"
    }
}
